	local txt = label(box, "", 11, FONT, T.Text, {
		Position = UDim2.fromOffset(8, 0),
		Size = UDim2.new(1, -28, 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 4,
	})
	local chev, chevParts = drawChevron(box, T.Dim, UDim2.new(1, -13, 0.5, 0))
	win:_reg(box)

	local ITEM_H, PAD = 22, 4
	local lst = new("CanvasGroup", {
		Visible = false,
		Active = true,
		BackgroundColor3 = T.Field,
		GroupTransparency = 1,
		Size = UDim2.fromOffset(100, 0),
		Parent = win.Overlay,
	}, { corner(5), stroke(T.Stroke, 1) })

	local el = { Row = row, Options = o.Options or {}, Multi = multi }
	local selected = {}
	local single = nil
	local items, fullH = {}, 0
	local popup, isOpen, follow, width = {}, false, nil, 100

	local function isSel(opt)
		if multi then return selected[opt] == true end
		return single == opt
	end
	local function summary()
		if multi then
			local t = {}
			for _, opt in ipairs(el.Options) do
				if selected[opt] then t[#t + 1] = tostring(opt) end
			end
			return #t > 0 and table.concat(t, ", ") or (o.Placeholder or "None")
		end
		return single ~= nil and tostring(single) or (o.Placeholder or "Select")
	end
	local function paintItems(instant)
		for _, it in ipairs(items) do
			local on = isSel(it.Opt)
			go(it.Label, 0.18, { TextColor3 = on and T.Text or T.Dim }, instant)
			go(it.Bar, 0.18, { BackgroundTransparency = on and 0 or 1 }, instant)
			go(it.Check, 0.18, { TextTransparency = on and 0 or 1 }, instant)
		end
		txt.Text = summary()
	end
	local function build()
		for _, it in ipairs(items) do it.Btn:Destroy() end
		items = {}
		for i, opt in ipairs(el.Options) do
			local b = new("TextButton", {
				Text = "",
				AutoButtonColor = false,
				BackgroundColor3 = T.Header,
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(PAD, PAD + (i - 1) * ITEM_H),
				Size = UDim2.new(1, -PAD * 2, 0, ITEM_H),
				Parent = lst,
			}, { corner(4) })
			local bar = new("Frame", {
				BackgroundColor3 = T.Text,
				BorderSizePixel = 0,
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 2, 0.5, 0),
				Size = UDim2.fromOffset(2, 12),
				BackgroundTransparency = 1,
				Parent = b,
			}, { pill() })
			local lb = label(b, tostring(opt), 11, FONT, T.Dim, { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -34, 1, 0) })
			local ck = new("TextLabel", {
				BackgroundTransparency = 1,
				Text = "✓",
				Font = BOLD,
				TextSize = 12,
				TextColor3 = T.Text,
				TextTransparency = 1,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -6, 0.5, 0),
				Size = UDim2.fromOffset(16, 16),
				Parent = b,
			})
			b.MouseEnter:Connect(function() tween(b, 0.12, { BackgroundTransparency = 0.5 }) end)
			b.MouseLeave:Connect(function() tween(b, 0.12, { BackgroundTransparency = 1 }) end)
			b.MouseButton1Click:Connect(function()
				if multi then
					selected[opt] = not selected[opt] or nil
				else
					single = opt
				end
				paintItems()
				fire(o.Callback, el:Get())
				if not multi then popup.Close() end
			end)
			items[i] = { Btn = b, Bar = bar, Label = lb, Check = ck, Opt = opt }
		end
		fullH = PAD * 2 + #el.Options * ITEM_H
		paintItems(true)
	end

	local function place()
		local p, s = box.AbsolutePosition, box.AbsoluteSize
		lst.Position = UDim2.fromOffset(p.X, p.Y + s.Y + 4)
	end
	function popup.Contains(pt)
		return inside(box, pt) or (lst.Visible and inside(lst, pt))
	end
	function popup.Close()
		if not isOpen then return end
		isOpen = false
		if win._popup == popup then win._popup = nil end
		if follow then follow:Disconnect(); follow = nil end
		tween(chev, 0.25, { Rotation = 180 })
		tint(chevParts, T.Dim)
		tween(bst, 0.2, { Color = T.Stroke })
		tween(lst, 0.2, { GroupTransparency = 1, Size = UDim2.fromOffset(width, 0) })
		task.delay(0.22, function()
			if not isOpen then lst.Visible = false end
		end)
	end
	function popup.Open()
		if isOpen then return end
		win:_setPopup(popup)
		isOpen = true
		width = box.AbsoluteSize.X
		lst.Size = UDim2.fromOffset(width, 0)
		lst.GroupTransparency = 1
		place()
		lst.Visible = true
		tween(lst, 0.28, { GroupTransparency = 0, Size = UDim2.fromOffset(width, fullH) })
		tween(chev, 0.25, { Rotation = 0 })
		tint(chevParts, T.Text)
		tween(bst, 0.2, { Color = Color3.fromHex("505050") })
		follow = RunService.RenderStepped:Connect(place)
	end
	box.MouseButton1Click:Connect(function()
		if isOpen then popup.Close() else popup.Open() end
	end)
	box.MouseEnter:Connect(function()
		if not isOpen then tween(bst, 0.15, { Color = Color3.fromHex("505050") }) end
	end)
	box.MouseLeave:Connect(function()
		if not isOpen then tween(bst, 0.15, { Color = T.Stroke }) end
	end)

	function el:Get()
		if multi then
			local t = {}
			for _, opt in ipairs(self.Options) do
				if selected[opt] then t[#t + 1] = opt end
			end
			return t
		end
		return single
	end
	function el:Set(v, silent)
		if multi then
			selected = {}
			for _, opt in ipairs(type(v) == "table" and v or { v }) do
				selected[opt] = true
			end
		else
			single = v
		end
		paintItems()
		if not silent then fire(o.Callback, self:Get()) end
	end
	function el:Refresh(options)
		self.Options = options
		build()
	end

	if multi then
		for _, opt in ipairs(type(o.Default) == "table" and o.Default or {}) do
			selected[opt] = true
		end
	else
		single = o.Default or (not o.NoDefault and el.Options[1] or nil)
	end
	build()
	return el
end

