function Card:AddKeybind(o)
	local win = self.Win
	local row = self:_row(o.Name, 22)
	local lbl = label(row, o.Name, 12, FONT, T.Text, { Size = UDim2.new(0.5, 0, 1, 0) })
	local el = { Row = row }
	local kb = keybindBox(win, row, UDim2.fromOffset(96, 20), UDim2.fromScale(1, 0.5), Vector2.new(1, 0.5), o.Default, function(k)
		fire(o.Changed, k)
	end)
	local hit = new("TextButton", {
		Text = "",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -100, 1, 0),
		ZIndex = 2,
		Parent = row,
	})
	win:_reg(hit)
	hit.MouseButton1Click:Connect(function() kb:Begin() end)
	win:_connect(UIS.InputBegan, function(input, gp)
		if not gp and not kb.Waiting and kb.Value and input.KeyCode == kb.Value then
			fire(o.Callback, kb.Value)
		end
	end)
	function el:Get() return kb.Value end
	function el:Set(k, silent) kb:Set(k, silent) end
	return el
end

