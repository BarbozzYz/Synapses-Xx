		return self.Value
	end
	function el:Set(v, silent, instant)
		v = not not v
		self.Value = v
		go(fill, 0.28, { Size = v and UDim2.fromScale(1, 1) or UDim2.fromScale(0, 0) }, instant)
		go(mark, 0.2, { TextTransparency = v and 0 or 1 }, instant)
		go(markScale, 0.3, { Scale = v and 1 or 0.3 }, instant, v and Enum.EasingStyle.Back or Enum.EasingStyle.Quint)
		go(lbl, 0.2, { TextColor3 = v and T.Text or T.Dim }, instant)
		go(bst, 0.2, { Color = v and T.Accent or T.Stroke }, instant)
		if not silent then
