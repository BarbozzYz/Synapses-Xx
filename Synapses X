-- ---------- SLIDER ----------
function Card:AddSlider(o)
	local win = self.Win
	local min, max, inc = o.Min or 0, o.Max or 100, o.Increment or 1
	local suffix = o.Suffix or ""
	local row = self:_row(o.Name, 34)
	local lbl = label(row, o.Name, 11, FONT, T.Dim, { Size = UDim2.new(0.7, 0, 0, 14) })
	local val = label(row, "", 11, FONT, T.Dim, { Size = UDim2.new(1, 0, 0, 14), TextXAlignment = Enum.TextXAlignment.Right })
	local bar = new("Frame", {
		BackgroundColor3 = Color3.fromHex("202020"),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(1, 0, 0, 4),
		Parent = row,
	}, { pill() })
	local fill = new("Frame", {
		BackgroundColor3 = T.Accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = bar,
	}, { pill() })
	local hit = new("TextButton", {
		Text = "",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 12),
		Size = UDim2.new(1, 0, 0, 22),
		ZIndex = 4,
		Parent = row,
	})
	win:_reg(hit)

	local el = { Row = row }
	local value = math.clamp(o.Default or min, min, max)
	local target = (value - min) / (max - min)
	local shown = target
	local dragging, hovering, conn = false, false, nil

	local function paintHot()
		local c = (dragging or hovering) and T.Text or T.Dim
		tween(lbl, 0.15, { TextColor3 = c })
		tween(val, 0.15, { TextColor3 = c })
	end
	local function render(a)
		fill.Size = UDim2.new(a, 0, 1, 0)
	end
	local function setValue(a, silent)
		a = math.clamp(a, 0, 1)
		local v = min + a * (max - min)
		v = math.clamp(math.floor(v / inc + 0.5) * inc, min, max)
		v = tonumber(string.format("%.4f", v))
		target = (v - min) / (max - min)
		val.Text = tostring(v) .. suffix
		if v ~= value then
			value = v
			if not silent then fire(o.Callback, v) end
		end
	end
	local function loop()
		if conn then return end
		conn = RunService.RenderStepped:Connect(function(dt)
			if dragging then
				setValue((mousePos().X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1))
			end
			shown = shown + (target - shown) * (1 - math.exp(-dt * 12))
			render(shown)
			if not dragging and math.abs(target - shown) < 0.0005 then
				shown = target
				render(shown)
				conn:Disconnect()
				conn = nil
			end
		end)
	end
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			paintHot()
			loop()
		end
	end)
	hit.MouseEnter:Connect(function() hovering = true; paintHot() end)
	hit.MouseLeave:Connect(function() hovering = false; if not dragging then paintHot() end end)
	win:_connect(UIS.InputEnded, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
			paintHot()
		end
	end)

	val.Text = tostring(value) .. suffix
	render(shown)
	function el:Get() return value end
	function el:Set(v, silent)
		setValue((v - min) / (max - min), silent)
		loop()
	end
	return el
end

