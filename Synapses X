function Card:_contentH()
	local h, n = 0, 0
	for _, r in ipairs(self._rows) do
		if r.Row.Visible then
			h += r.H
			n += 1
		end
	end
	if n == 0 then
		return 0
	end
	return h + 6 * (n - 1) + 16
end

function Card:_apply(animate)
	local ch = self.Open and self:_contentH() or 0
	go(self._clip, 0.32, { Size = UDim2.new(1, 0, 0, ch) }, not animate)
	go(self._holder, 0.32, { Size = UDim2.new(1, 0, 0, 31 + ch) }, not animate)
end

function Card:SetOpen(v, instant)
	v = not not v
	self.Open = v
	go(self._chev, 0.28, { Rotation = v and 0 or 180 }, instant)
	go(self._line, 0.28, { BackgroundTransparency = v and 0.15 or 1 }, instant)
	go(self._title, 0.28, { TextColor3 = v and T.Text or T.Dim }, instant)
	go(self._header, 0.28, { BackgroundColor3 = v and T.Header or T.Card:Lerp(T.Header, 0.5) }, instant)
	tint(self._chevParts, v and T.Text or T.Dim, instant)
	self:_apply(not instant)
	if not v then
		self.Win:_closePopup()
	end
end

function Card:_row(name, h)
	local row = new("Frame", {
		Name = name or "Row",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, h),
		LayoutOrder = #self._rows + 1,
		Parent = self._body,
	})
	table.insert(self._rows, { Row = row, H = h, Name = name or "" })
	self:_apply(false)
	return row
end

function SubTab:AddCard(o)
	o = o or {}
	local win = self.Win
	local right = o.Side == "Right" or (o.Side == nil and #self.Cards % 2 == 1)
	local card = setmetatable({ Win = win, Sub = self, Title = o.Title or "Card", Open = o.Open ~= false, _rows = {} }, Card)

	local holder = new("Frame", {
		Name = card.Title,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 31),
		LayoutOrder = #self.Cards + 1,
		Parent = right and self.Right or self.Left,
	})
	local frame = new("CanvasGroup", {
		BackgroundColor3 = T.Card,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = holder,
	}, { corner(6), stroke(T.Line, 1, 0.3) })

	local header = new("TextButton", {
		Name = "Header",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = T.Header,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 30),
		Parent = frame,
	})
	card._title = label(header, card.Title, 13, FONT, T.Text, {
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.new(1, -40, 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	card._chev, card._chevParts = drawChevron(header, T.Text, UDim2.new(1, -18, 0.5, 0))
	card._line = new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 0, 1),
		Parent = frame,
	}, { new("UIGradient", { Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 0.85),
	}) }) })
	card._clip = new("Frame", {
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(0, 31),
		Size = UDim2.new(1, 0, 0, 0),
		Parent = frame,
	})
	card._body = new("Frame", {
