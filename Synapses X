local function keybindBox(win, parent, size, pos, anchor, default, onChange)
	local btn = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = T.Field,
		Size = size,
		AnchorPoint = anchor,
		Position = pos,
		ZIndex = 3,
		Parent = parent,
	}, { corner(4) })
	local st = new("UIStroke", { Color = T.Stroke, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = btn })
	local sc = new("UIScale", { Parent = btn })
	local ico = makeIcon(btn, "keyboard", 13, T.Dimmer, UDim2.fromOffset(15, size.Y.Offset / 2), 4)
	local txt = label(btn, "Keybind", 11, FONT, T.Dimmer, {
		Position = UDim2.fromOffset(ico and 26 or 0, 0),
		Size = UDim2.new(1, -(ico and 26 or 0), 1, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 4,
	})
	win:_reg(btn)

	local obj = { Button = btn, Value = default, Waiting = false }
	local token = 0

	local function show()
		local n = shortKey(obj.Value)
		txt.Text = n or "Keybind"
		txt.TextColor3 = n and T.Text or T.Dimmer
		if ico then
			ico.ImageColor3 = n and T.Dim or T.Dimmer
		end
	end
	local function press(depth)
		tween(sc, 0.08, { Scale = depth }).Completed:Connect(function()
			tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		end)
	end

	function obj:Begin()
		if self.Waiting then
			return
		end
		self.Waiting = true
		token += 1
		local my = token
		press(0.92)
		tween(st, 0.2, { Color = T.Text })
		txt.TextColor3 = T.Text
		task.spawn(function()
			local n = 1
			while obj.Waiting and token == my do
				txt.Text = string.rep(".", n)
				n = n % 3 + 1
				task.wait(0.7)
			end
		end)
	end
	function obj:Get()
		return self.Value
	end
	function obj:Set(k, silent)
		self.Value = k
		show()
		if not silent then
			fire(onChange, k)
		end
	end

	btn.MouseButton1Click:Connect(function()
		obj:Begin()
	end)
	btn.MouseEnter:Connect(function()
		if not obj.Waiting then
			tween(st, 0.15, { Color = Color3.fromHex("505050") })
		end
	end)
	btn.MouseLeave:Connect(function()
		if not obj.Waiting then
			tween(st, 0.15, { Color = T.Stroke })
		end
	end)
	win:_connect(UIS.InputBegan, function(input)
		if obj.Waiting and input.UserInputType == Enum.UserInputType.Keyboard then
			obj.Waiting = false
			token += 1
			if input.KeyCode == Enum.KeyCode.Escape then
				obj.Value = nil
			elseif input.KeyCode ~= Enum.KeyCode.Unknown then
				obj.Value = input.KeyCode
			end
			tween(st, 0.2, { Color = T.Stroke })
			show()
			press(0.95)
			fire(onChange, obj.Value)
		end
	end)
	show()
	return obj
end

