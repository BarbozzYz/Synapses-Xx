	local wrap = new("Frame", {
		BackgroundColor3 = T.Field,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.new(0.62, 0, 0, 20),
		ZIndex = 3,
		Parent = row,
	}, { corner(4) })
	local st = new("UIStroke", { Color = T.Stroke, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = wrap })
	local box = new("TextBox", {
		BackgroundTransparency = 1,
		Text = o.Default or "",
		PlaceholderText = o.Placeholder or "Enter text...",
		PlaceholderColor3 = T.Dimmer,
		ClearTextOnFocus = false,
		Font = FONT,
		TextSize = 11,
		TextColor3 = T.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(8, 0),
		Size = UDim2.new(1, -16, 1, 0),
		ZIndex = 4,
		Parent = wrap,
	})
	win:_reg(wrap)
	box.Focused:Connect(function() tween(st, 0.15, { Color = T.Text }) end)
	box.FocusLost:Connect(function(enter)
		tween(st, 0.15, { Color = T.Stroke })
		fire(o.Callback, box.Text, enter)
	end)
