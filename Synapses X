-- ====================================================================
-- SUB-TAB / TAB
-- ====================================================================
local HEADH, SUBH = 30, 26

function SubTab:_paint(on, instant)
	go(self._bg, 0.2, { BackgroundTransparency = on and 0 or 1 }, instant)
	go(self._label, 0.2, { TextColor3 = on and T.Text or T.Dim }, instant)
	if self._icon then
		go(self._icon, 0.2, { ImageColor3 = on and T.Text or T.Dim }, instant)
	end
	go(self._bar, 0.25, { Size = UDim2.fromOffset(2, on and 14 or 0), BackgroundTransparency = on and 0 or 1 }, instant, on and Enum.EasingStyle.Back or Enum.EasingStyle.Quint)
end

function SubTab:_playIn()
	self.Page.Position = UDim2.fromOffset(18, 0)
	tween(self.Page, 0.4, { Position = UDim2.fromOffset(0, 0) })
	for i, card in ipairs(self.Cards) do
		card.Frame.GroupTransparency = 1
		card.Frame.Position = UDim2.fromOffset(0, 14)
		task.delay((i - 1) * 0.06, function()
			tween(card.Frame, 0.4, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) })
		end)
	end
end

function SubTab:Select(instant)
	self.Win:_selectSub(self, instant)
end

function Tab:_apply(animate)
	local h = self.Open and (#self.SubTabs * (SUBH + 2) + 4) or 0
	go(self._list, 0.3, { Size = UDim2.new(1, 0, 0, h) }, not animate)
	go(self._holder, 0.3, { Size = UDim2.new(1, 0, 0, HEADH + 2 + h) }, not animate)
end

function Tab:SetOpen(v, instant)
	self.Open = not not v
	go(self._chev, 0.28, { Rotation = self.Open and 180 or 0 }, instant)
	self:_apply(not instant)
end

function Tab:AddSubTab(o)
	if type(o) == "string" then o = { Name = o } end
	local win = self.Win
	local idx = #self.SubTabs + 1
	local sub = setmetatable({ Win = win, Tab = self, Name = o.Name, Cards = {} }, SubTab)

	local btn = new("TextButton", {
		Name = o.Name,
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, SUBH),
		LayoutOrder = idx,
		Parent = self._list,
	})
	sub._bg = new("Frame", {
		BackgroundColor3 = T.Header,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = btn,
	}, { corner(5) })
	-- barra indicadora: dentro do botao (x=2), garantidamente visivel
	sub._bar = new("Frame", {
		BackgroundColor3 = T.Text,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 2, 0.5, 0),
		Size = UDim2.fromOffset(2, 0),
		Parent = btn,
	}, { pill() })
	sub._icon = makeIcon(btn, o.Icon, 14, T.Dim, UDim2.fromOffset(24, SUBH / 2))
	sub._label = label(btn, o.Name, 12, FONT, T.Dim, {
		Position = UDim2.fromOffset(sub._icon and 40 or 14, 0),
		Size = UDim2.new(1, -44, 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	sub.Button = btn
	win:_reg(btn)

	btn.MouseEnter:Connect(function()
		if win.ActiveSub ~= sub then
			tween(sub._label, 0.15, { TextColor3 = Color3.fromRGB(190, 190, 190) })
		end
	end)
	btn.MouseLeave:Connect(function()
		if win.ActiveSub ~= sub then
			tween(sub._label, 0.15, { TextColor3 = T.Dim })
		end
	end)
	btn.MouseButton1Click:Connect(function()
		win:_selectSub(sub)
	end)

	sub.Page = new("Frame", {
		Name = o.Name,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Parent = win._pages,
	})
	local scroll = new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = T.Stroke,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		Parent = sub.Page,
	})
	local colHolder = new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = scroll,
	}, { listLayout(12, Enum.FillDirection.Horizontal), pad(14, 14, 16, 14) })
	local function column(order)
		return new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(0.5, -6, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = order,
			Parent = colHolder,
		}, { listLayout(12) })
	end
	sub.Left, sub.Right = column(1), column(2)

	table.insert(self.SubTabs, sub)
	self:_apply(false)
	if not win.ActiveSub then
		win:_selectSub(sub, true)
	end
	return sub
end

function Window:AddTab(o)
	if type(o) == "string" then o = { Name = o } end
	local tab = setmetatable({ Win = self, Name = o.Name, SubTabs = {}, Open = o.Open ~= false }, Tab)
	tab._holder = new("Frame", {
		Name = o.Name,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, HEADH + 2),
		LayoutOrder = #self.Tabs + 1,
		Parent = self._tabList,
	}, { listLayout(2) })
	local header = new("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, HEADH),
		LayoutOrder = 1,
		Parent = tab._holder,
	})
	local ico = makeIcon(header, o.Icon, 15, T.Dim, UDim2.fromOffset(16, HEADH / 2))
	local lbl = label(header, string.upper(o.Name), 11, BOLD, T.Dim, {
		Position = UDim2.fromOffset(ico and 34 or 12, 0),
		Size = UDim2.new(1, -60, 1, 0),
	})
	local chev, chevParts = drawChevron(header, T.Dim, UDim2.new(1, -14, 0.5, 0))
	chev.Rotation = 180
	tab._chev = chev
	tab._list = new("Frame", {
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Size = UDim2.new(1, 0, 0, 0),
		LayoutOrder = 2,
		Parent = tab._holder,
	}, { listLayout(2), pad(0, 2, 0, 2) })
	self:_reg(header)
	header.MouseEnter:Connect(function()
		tween(lbl, 0.15, { TextColor3 = T.Text })
		if ico then tween(ico, 0.15, { ImageColor3 = T.Text }) end
		tint(chevParts, T.Text)
	end)
	header.MouseLeave:Connect(function()
		tween(lbl, 0.15, { TextColor3 = T.Dim })
		if ico then tween(ico, 0.15, { ImageColor3 = T.Dim }) end
		tint(chevParts, T.Dim)
	end)
	header.MouseButton1Click:Connect(function()
		tab:SetOpen(not tab.Open)
	end)
	table.insert(self.Tabs, tab)
	tab:SetOpen(tab.Open, true)
	return tab
end

-- ====================================================================
-- WINDOW
-- ====================================================================
function Window:_connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(self._conns, c)
	return c
end

function Window:_reg(obj)
	table.insert(self._ui, obj)
	obj.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			calibrate(obj)
		end
	end)
	return obj
end

function Window:_overInteractive(p)
	for _, o in ipairs(self._ui) do
		if o.Parent and realHit(o, p) then
			return true
		end
	end
	return false
end

function Window:_setPopup(p)
	if self._popup and self._popup ~= p then
		self._popup.Close()
	end
	self._popup = p
end

function Window:_closePopup()
	if self._popup then
		self._popup.Close()
	end
end

function Window:_selectSub(sub, instant)
	local prev = self.ActiveSub
	if prev == sub then return end
	self.ActiveSub = sub
	self:_closePopup()
	for _, t in ipairs(self.Tabs) do
		for _, s in ipairs(t.SubTabs) do
			local on = s == sub
			s:_paint(on, instant)
			s.Page.Visible = on
		end
	end
	if not instant then
		sub:_playIn()
	end
end

function Window:_applySearch()
	local q = string.lower(self._query or "")
	for _, tab in ipairs(self.Tabs) do
		for _, sub in ipairs(tab.SubTabs) do
			for _, card in ipairs(sub.Cards) do
				local titleHit = q == "" or string.find(string.lower(card.Title), q, 1, true) ~= nil
				local any = false
				for _, r in ipairs(card._rows) do
					local hit = titleHit or string.find(string.lower(r.Name), q, 1, true) ~= nil
					r.Row.Visible = hit
					any = any or hit
				end
				card._holder.Visible = titleHit or any
				card:_apply(false)
			end
		end
	end
end

function Window:Toggle(v)
	if v == nil then v = not self.Shown end
	self.Shown = v
	local base = self._baseScale or 1
	if v then
		self.Root.Visible = true
		self.Overlay.Visible = true
		self._scale.Scale = base * 0.9
		tween(self._scale, 0.45, { Scale = base }, Enum.EasingStyle.Back)
		for _, g in ipairs(self._groups) do
			tween(g, 0.3, { GroupTransparency = 0 })
		end
		if self.ActiveSub then self.ActiveSub:_playIn() end
	else
		self:_closePopup()
		tween(self._scale, 0.25, { Scale = base * 0.92 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		for _, g in ipairs(self._groups) do
			tween(g, 0.25, { GroupTransparency = 1 })
		end
		task.delay(0.27, function()
			if not self.Shown then
				self.Root.Visible = false
				self.Overlay.Visible = false
			end
		end)
	end
end

function Window:Destroy()
	self:_closePopup()
	for _, c in ipairs(self._conns) do c:Disconnect() end
	self.Root:Destroy()
	self.Overlay:Destroy()
end

function Lib:CreateWindow(opts)
	opts = opts or {}
	if opts.AutoLucide ~= false and not Lib.IconModule and not Lib._lucideTried then
		Lib._lucideTried = true
		Lib:LoadLucide()
	end
	local gui = getGui()
	local vp = viewport()
	local W = opts.Size and opts.Size.X.Offset or 780
	local H = opts.Size and opts.Size.Y.Offset or 520
	local hasPreview = opts.Preview ~= false
	local PW, GAP = opts.PreviewWidth or 250, 8
	local SB, TOPH, FOOTH = 170, 44, 60
	local extra = hasPreview and (PW + GAP) or 0
	local totalW = W + extra

	local win = setmetatable({
		Gui = gui, Tabs = {}, _conns = {}, _ui = {}, _query = "", _groups = {}, Shown = false,
	}, Window)
	if opts.ToggleKey == nil then
		win.ToggleKey = Enum.KeyCode.RightShift
	else
		win.ToggleKey = opts.ToggleKey or nil
	end

	local curPos = Vector2.new(math.floor((vp.X - totalW) / 2), math.floor((vp.Y - H) / 2))
	local tgtPos = curPos

	local root = new("Frame", {
		Name = "Window",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(totalW, H),
		Position = UDim2.fromOffset(curPos.X + totalW / 2, curPos.Y + H / 2),
		Visible = false,
		Parent = gui,
	})
	local BASE_SCALE = opts.UIScale or 1.0
	win._scale = new("UIScale", { Scale = BASE_SCALE * 0.9, Parent = root })
	local overlay = new("Frame", {
		Name = "Overlay",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 100,
		Visible = false,
		Parent = gui,
	})
	win.Root, win.Overlay, win._baseScale = root, overlay, BASE_SCALE

	local main = new("CanvasGroup", {
		Name = "Main",
		BackgroundColor3 = T.Background,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		Size = UDim2.new(1, -extra, 1, 0),
		Parent = root,
	}, { corner(8), stroke(T.Line, 1, 0.4) })
	table.insert(win._groups, main)
	win.Main = main

	local side = new("Frame", {
		Name = "Sidebar",
		BackgroundColor3 = T.Side,
		BorderSizePixel = 0,
		Size = UDim2.new(0, SB, 1, 0),
		Parent = main,
	})
	label(side, opts.Title or "Synapses Y", 18, BOLD, T.Text, {
		Position = UDim2.fromOffset(20, 18),
		Size = UDim2.new(1, -30, 0, 30),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	win._tabList = new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 64),
		Size = UDim2.new(1, 0, 1, -(64 + FOOTH)),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 0,
		Parent = side,
	}, { listLayout(6), pad(8, 0, 8, 0) })

	new("Frame", {
		BackgroundColor3 = Color3.fromRGB(110, 110, 110),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(SB, 0),
		Size = UDim2.new(0, 1, 1, 0),
		Parent = main,
	}, { new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, 0.55),
		NumberSequenceKeypoint.new(1, 1),
	}) }) })

	local foot = new("Frame", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, FOOTH),
		Parent = side,
	})
	new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(1, 0, 0, 1),
		Parent = foot,
	}, { new("UIGradient", { Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, 0.7),
		NumberSequenceKeypoint.new(1, 1),
	}) }) })
	local avatar = new("ImageLabel", {
		BackgroundColor3 = Color3.fromRGB(34, 34, 34),
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 2),
		Size = UDim2.fromOffset(32, 32),
		Parent = foot,
	}, { pill() })
	task.spawn(function()
		local ok, url = pcall(function()
			return Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
		if ok and url then avatar.Image = url end
	end)
	label(foot, opts.DisplayName or LocalPlayer.DisplayName, 12, BOLD, T.Text, {
		Position = UDim2.fromOffset(56, 14),
		Size = UDim2.new(1, -62, 0, 16),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	label(foot, "@" .. (opts.Username or LocalPlayer.Name), 10, FONT, T.Dimmer, {
		Position = UDim2.fromOffset(56, 30),
		Size = UDim2.new(1, -62, 0, 14),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})

	local content = new("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(SB + 1, 0),
		Size = UDim2.new(1, -(SB + 1), 1, 0),
		Parent = main,
	})
	new("Frame", {
		BackgroundColor3 = Color3.fromRGB(140, 140, 140),
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, TOPH),
		Size = UDim2.new(1, 0, 0, 1),
		Parent = content,
	}, { new("UIGradient", { Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, 0.35),
		NumberSequenceKeypoint.new(1, 1),
	}) }) })

	-- rede de nodes animada atras dos cards (valida em qualquer tab/sub-tab)
	local netBG = createNetworkBG(content)
	netBG.Position = UDim2.fromOffset(0, TOPH + 1)
	netBG.Size = UDim2.new(1, 0, 1, -(TOPH + 1))

	win._pages = new("Frame", {
		Name = "Pages",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(0, TOPH + 1),
		Size = UDim2.new(1, 0, 1, -(TOPH + 1)),
		Parent = content,
	})

	local searchBtn = new("TextButton", {
		Text = "",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0, TOPH / 2),
		Size = UDim2.fromOffset(28, 28),
		Parent = content,
	})
	local _, searchParts = drawSearch(searchBtn, T.Dim, UDim2.fromScale(0.5, 0.5))
	win:_reg(searchBtn)
	local searchBox = new("Frame", {
		BackgroundColor3 = T.Field,
		ClipsDescendants = true,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -46, 0, TOPH / 2),
		Size = UDim2.fromOffset(0, 24),
		Parent = content,
	}, { corner(12) })
	local searchSt = new("UIStroke", {
		Color = T.Stroke, Thickness = 1, Transparency = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = searchBox,
	})
	local sbox = new("TextBox", {
		BackgroundTransparency = 1,
		Text = "",
		PlaceholderText = "Search...",
		PlaceholderColor3 = T.Dimmer,
		ClearTextOnFocus = false,
		Font = FONT,
		TextSize = 11,
		TextColor3 = T.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.fromOffset(12, 0),
		Size = UDim2.fromOffset(166, 24),
		Parent = searchBox,
	})
	win:_reg(searchBox)
	local searchOpen = false
	local function setSearch(v)
		searchOpen = v
		tween(searchBox, 0.35, { Size = UDim2.fromOffset(v and 190 or 0, 24) })
		tween(searchSt, 0.25, { Transparency = v and 0 or 1 })
		tint(searchParts, v and T.Text or T.Dim)
		if v then
			task.delay(0.2, function()
				if searchOpen then sbox:CaptureFocus() end
			end)
		else
			sbox:ReleaseFocus()
			sbox.Text = ""
		end
	end
	searchBtn.MouseButton1Click:Connect(function() setSearch(not searchOpen) end)
	searchBtn.MouseEnter:Connect(function()
		if not searchOpen then tint(searchParts, T.Text) end
	end)
	searchBtn.MouseLeave:Connect(function()
		if not searchOpen then tint(searchParts, T.Dim) end
	end)
	sbox.FocusLost:Connect(function()
		if sbox.Text == "" and searchOpen then setSearch(false) end
	end)
	win:_connect(sbox:GetPropertyChangedSignal("Text"), function()
		win._query = sbox.Text
		win:_applySearch()
	end)

	if hasPreview then
		local pv = new("CanvasGroup", {
			Name = "Preview",
			BackgroundColor3 = T.Side,
			BorderSizePixel = 0,
			GroupTransparency = 1,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			Size = UDim2.new(0, PW, 1, 0),
			Parent = root,
		}, { corner(8), stroke(T.Line, 1, 0.4) })
		table.insert(win._groups, pv)
		local head = new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, TOPH),
			Parent = pv,
		})
		local uico = makeIcon(head, "user", 15, T.Dim, UDim2.fromOffset(22, TOPH / 2))
		label(head, "@" .. (opts.Username or LocalPlayer.Name), 12, BOLD, T.Text, {
			Position = UDim2.fromOffset(uico and 40 or 16, 0),
			Size = UDim2.new(1, -56, 1, 0),
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		new("Frame", {
			BackgroundColor3 = Color3.fromRGB(140, 140, 140),
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, TOPH),
			Size = UDim2.new(1, 0, 0, 1),
			Parent = pv,
		}, { new("UIGradient", { Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.5),
			NumberSequenceKeypoint.new(1, 1),
		}) }) })
		local vpf = new("ViewportFrame", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, TOPH + 1),
			Size = UDim2.new(1, 0, 1, -(TOPH + 1)),
			Ambient = Color3.fromRGB(170, 170, 170),
			LightColor = Color3.fromRGB(255, 255, 255),
			LightDirection = Vector3.new(0.3, -0.5, 1),
			Parent = pv,
		})
		local cam = new("Camera", { FieldOfView = 35, Parent = vpf })
		vpf.CurrentCamera = cam

		local model
		local function fit()
			if not model then return end
			local cf, size = model:GetBoundingBox()
			local dist = (size.Y / 2) / math.tan(math.rad(cam.FieldOfView / 2)) * 1.25 + size.Z
			cam.CFrame = CFrame.lookAt(Vector3.new(0, cf.Position.Y, -dist), Vector3.new(0, cf.Position.Y, 0))
		end
		local function refresh()
			if model then model:Destroy(); model = nil end
			local char = LocalPlayer.Character
			local m
			if char then
				local old = char.Archivable
				char.Archivable = true
				local ok, c = pcall(function() return char:Clone() end)
				char.Archivable = old
				if ok then m = c end
			end
			if not m then
				local ok, c = pcall(function()
					local desc = Players:GetHumanoidDescriptionFromUserId(LocalPlayer.UserId)
					return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
				end)
				if ok then m = c end
			end
			if not m then return end
			for _, d in ipairs(m:GetDescendants()) do
				if d:IsA("BaseScript") or d:IsA("Sound") then
					d:Destroy()
				elseif d:IsA("BasePart") then
					d.Anchored = true
				end
			end
			local hum = m:FindFirstChildOfClass("Humanoid")
			if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
			m.Parent = vpf
			m:PivotTo(CFrame.new(0, 0, 0))
			model = m
			fit()
		end
		task.spawn(refresh)
		win:_connect(LocalPlayer.CharacterAdded, function()
			task.wait(1)
			refresh()
		end)
		win.Preview = { Viewport = vpf, Refresh = refresh }
	end

	-- drag via UIS global: captura mesmo quando ScrollingFrame consome o InputBegan dos filhos
	local dragging, dragOff = false, Vector2.zero
	function win._beginDrag(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		local m = mousePos()
		local rp, rs = root.AbsolutePosition, root.AbsoluteSize
		if m.X < rp.X or m.X > rp.X + rs.X or m.Y < rp.Y or m.Y > rp.Y + rs.Y then
			return
		end
		if win._popup and win._popup.Contains(m) then return end
		if win:_overInteractive(m) then return end
		dragging = true
		dragOff = m - curPos
	end
	win:_connect(UIS.InputBegan, function(input, gp)
		if gp then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			-- drag
			win._beginDrag(input)
			-- fechar popup ao clicar fora
			if win._popup and not win._popup.Contains(mousePos()) then
				win._popup.Close()
			end
		elseif win.ToggleKey and input.KeyCode == win.ToggleKey then
			win:Toggle()
		end
	end)
	win:_connect(UIS.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	win:_connect(RunService.RenderStepped, function(dt)
		local v = viewport()
		if dragging then
			local m = mousePos()
			tgtPos = Vector2.new(
				math.clamp(m.X - dragOff.X, -totalW + 80, v.X - 80),
				math.clamp(m.Y - dragOff.Y, 0, v.Y - 40)
			)
		end
		if (tgtPos - curPos).Magnitude > 0.05 then
			curPos = curPos:Lerp(tgtPos, 1 - math.exp(-dt * 18))
			root.Position = UDim2.fromOffset(math.floor(curPos.X + totalW / 2 + 0.5), math.floor(curPos.Y + H / 2 + 0.5))
		end
	end)

	task.defer(function()
		win:Toggle(true)
	end)

	return win
end

return Lib
