		if not box:IsFocused() then tween(st, 0.15, { Color = Color3.fromHex("505050") }) end
	end)
	wrap.MouseLeave:Connect(function()
		if not box:IsFocused() then tween(st, 0.15, { Color = T.Stroke }) end
	end)
	return {
		Row = row,
		Get = function() return box.Text end,
		Set = function(_, v, silent)
			box.Text = tostring(v)
			if not silent then fire(o.Callback, box.Text, false) end
		end,
	}
end

