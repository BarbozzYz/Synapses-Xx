		end
	end
	local function flip()
		el:Set(not el.Value)
	end
	box.MouseButton1Click:Connect(flip)
	hit.MouseButton1Click:Connect(flip)
	hit.MouseEnter:Connect(function()
		if not el.Value then
			tween(lbl, 0.15, { TextColor3 = Color3.fromRGB(180, 180, 180) })
		end
	end)
	hit.MouseLeave:Connect(function()
		if not el.Value then
			tween(lbl, 0.15, { TextColor3 = T.Dim })
		end
	end)

	if o.Keybind ~= false then
		local dots = new("TextButton", {
			Text = "",
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(24, 22),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(1, 0.5),
			ZIndex = 3,
			Parent = row,
		})
		local _, dotParts = drawDots(dots, T.Dimmer, UDim2.fromScale(0.5, 0.5))
		win:_reg(dots)

		local PWID, PHEI = 176, 64
		local pop = new("CanvasGroup", {
			Visible = false,
			Active = true,
			BackgroundColor3 = T.Card,
			GroupTransparency = 1,
			Size = UDim2.fromOffset(PWID, PHEI),
			Parent = win.Overlay,
		}, { corner(6), stroke(T.Stroke, 1) })
		local popScale = new("UIScale", { Scale = 0.92, Parent = pop })
		label(pop, "Keybind", 11, FONT, T.Dim, { Position = UDim2.fromOffset(12, 8), Size = UDim2.fromOffset(60, 20) })
		label(pop, "Mode", 11, FONT, T.Dim, { Position = UDim2.fromOffset(12, 36), Size = UDim2.fromOffset(60, 20) })
		local kb = keybindBox(win, pop, UDim2.fromOffset(92, 20), UDim2.fromOffset(PWID - 12, 18), Vector2.new(1, 0.5), el.Key, function(k)
			el.Key = k
			fire(o.KeyChanged, k)
		end)
		local modeBtn = new("TextButton", {
			Text = el.Mode,
			Font = FONT,
			TextSize = 11,
			TextColor3 = T.Text,
			AutoButtonColor = false,
			BackgroundColor3 = T.Field,
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromOffset(PWID - 12, 46),
			Size = UDim2.fromOffset(92, 20),
			ZIndex = 3,
			Parent = pop,
		}, { corner(4), stroke(T.Stroke, 1) })
		win:_reg(modeBtn)
		modeBtn.MouseButton1Click:Connect(function()
			el.Mode = el.Mode == "Toggle" and "Hold" or "Toggle"
			modeBtn.Text = el.Mode
		end)

		local popup, isOpen, follow = {}, false, nil
		local function place()
			local p, s = dots.AbsolutePosition, dots.AbsoluteSize
			local x = math.clamp(p.X + s.X - PWID, 8, math.max(8, viewport().X - PWID - 8))
			pop.Position = UDim2.fromOffset(x, p.Y + s.Y + 4)
		end
		function popup.Contains(pt)
			return inside(dots, pt) or (pop.Visible and inside(pop, pt))
		end
		function popup.Close()
			if not isOpen then return end
			isOpen = false
			if win._popup == popup then win._popup = nil end
			if follow then follow:Disconnect(); follow = nil end
			tween(pop, 0.18, { GroupTransparency = 1 })
			tween(popScale, 0.18, { Scale = 0.92 })
			tint(dotParts, T.Dimmer)
			task.delay(0.2, function()
				if not isOpen then pop.Visible = false end
			end)
		end
		function popup.Open()
			if isOpen then return end
			win:_setPopup(popup)
			isOpen = true
			place()
			pop.Visible = true
			tween(pop, 0.25, { GroupTransparency = 0 })
			tween(popScale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
			tint(dotParts, T.Text)
			follow = RunService.RenderStepped:Connect(place)
		end
		dots.MouseButton1Click:Connect(function()
			if isOpen then popup.Close() else popup.Open() end
		end)
		dots.MouseEnter:Connect(function()
			if not isOpen then tint(dotParts, T.Dim) end
		end)
		dots.MouseLeave:Connect(function()
			if not isOpen then tint(dotParts, T.Dimmer) end
		end)

		win:_connect(UIS.InputBegan, function(input, gp)
			if gp or kb.Waiting or not el.Key or input.KeyCode ~= el.Key then return end
			if el.Mode == "Hold" then el:Set(true) else flip() end
		end)
		win:_connect(UIS.InputEnded, function(input)
			if el.Mode == "Hold" and el.Key and input.KeyCode == el.Key then
				el:Set(false)
			end
		end)
		function el:SetKey(k)
			kb:Set(k, true)
			self.Key = k
		end
	end

	el:Set(o.Default, true, true)
	return el
end

